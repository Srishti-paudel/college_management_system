const jwt = require('jsonwebtoken')
const bcrypt = require('bcryptjs')        // ← was missing, bcrypt was used but never imported
const { User } = require('../model/userModel')  // ← destructure, your model exports { User }
require('dotenv').config()

const registerUser = async (req, res) => {
    try {
        const { name, Faculty, shift, Regd_No, email, password } = req.body

        if (!name || !Faculty || !shift || !Regd_No || !email || !password) {
            return res.status(400).json({ message: "All fields are required" })
        }

        // Check existing user by email OR Regd_No separately
        const isExistingUser = await User.findOne({
            where: { email }   // ← original checked both at once with AND, 
        })                     //   meaning same email AND same Regd_No — easy to bypass
        
        if (isExistingUser) {
            return res.status(400).json({ message: "User already exists" })
        }

        await User.create({    // ← was missing await
            name,
            Faculty,
            shift,
            email,
            password: bcrypt.hashSync(password, 10),
            Regd_No,
            Role: 'student'    // ← default role on register
        })

        return res.status(201).json({ message: "User registered successfully" })

    } catch (err) {
        return res.status(500).json({ message: err.message })
    }
}

const loginUser = async (req, res) => {
    try {
        const { email, password } = req.body

        if (!email || !password) {
            return res.status(400).json({ message: "All fields are required" })
        }

        const isExistingUser = await User.findOne({ where: { email } })

        if (!isExistingUser) {               // ← original had no check, would crash if user not found
            return res.status(400).json({ message: "User not found" })
        }

        const isPasswordValid = bcrypt.compareSync(password, isExistingUser.password)
        if (!isPasswordValid) {
            return res.status(400).json({ message: "Invalid credentials" })
        }

        const token = jwt.sign(
            {
                userId: isExistingUser.id,       // ← was user.id (undefined, user doesn't exist)
                Role: isExistingUser.Role,       // ← was user.userRole (wrong variable + wrong field)
                name: isExistingUser.name        // ← added, needed for markedByName in attendance
            },
            process.env.JWT_SECRET,
            { expiresIn: "1d" }
        )

        return res.json({ token })

    } catch (err) {
        return res.status(500).json({ message: err.message })
    }
}

